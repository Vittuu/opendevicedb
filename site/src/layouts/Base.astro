---
import "../styles/global.css";
import { SITE_NAME, REPO_URL, LICENSES, PITCH } from "../lib/config.ts";

interface Props { title?: string; description?: string; wide?: boolean }
const { title, description = PITCH } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — reverse-engineered devices, shared`;
const path = Astro.url.pathname;
const nav = [
  ["/devices/", "Devices"],
  ["/news/", "News"],
  ["/agents/", "For agents"],
  ["/contribute/", "Contribute"],
  ["/sources/", "Sources"],
  ["/about/", "About"],
];
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} news`} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4M7 9h2M11 9h6M7 12h6"/></svg>
          {SITE_NAME}
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          {SITE_NAME} is an independent, open project with no vendor affiliation.
          Code {LICENSES.code}, data {LICENSES.data}, agent skill file {LICENSES.skill}.
        </p>
        <ul class="footer-links">
          <li><a href={REPO_URL}>Source on GitHub</a></li>
          <li><a href="/policy/">Content policy</a></li>
          <li><a href="/api/index.json">JSON API</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li>No tracking, no cookies, no external scripts.</li>
        </ul>
      </div>
    </footer>
  </body>
</html>
