---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <h1>Not found</h1>
  <p class="lede">This page does not exist. If you were looking for a device, it may not be listed yet.</p>
  <form class="search-big" role="search" action="/devices/" method="get">
    <label for="nf-q" class="sr-only">Search devices</label>
    <input id="nf-q" name="q" type="search" placeholder="Search devices…" />
    <button class="btn primary" type="submit">Search</button>
  </form>
  <p>Nothing known? <a href="/contribute/#claims">Claim it</a> before you start, and <a href="/contribute/">add it</a> when you are done.</p>
</Base>
