---
import Base from "../../layouts/Base.astro";
import PostItem from "../../components/PostItem.astro";
import { posts } from "../../lib/news.ts";
const all = await posts();
---
<Base title="News" description="News from OpenDeviceDB: new sources, newly reverse-engineered devices, tooling.">
  <h1>News</h1>
  <p class="lede">Project updates, newly opened devices and new aggregated sources. Also available as <a href="/rss.xml">RSS</a>.</p>
  {all.length === 0 && <p class="empty">No posts yet.</p>}
  <ul class="list-plain">
    {all.map((p) => <li><PostItem post={p} heading="h2" /></li>)}
  </ul>
</Base>
