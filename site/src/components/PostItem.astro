---
import { postUrl, fmtDate, type Post } from "../lib/news.ts";
interface Props { post: Post; heading?: "h2" | "h3" }
const { post, heading = "h3" } = Astro.props;
const H = heading;
---
<article>
  <H style="margin:0 0 4px"><a href={postUrl(post)}>{post.data.title}</a></H>
  <div class="post-meta">
    <time datetime={fmtDate(post.data.date)}>{fmtDate(post.data.date)}</time>
    {post.data.draft && <span class="tag draft">draft</span>}
    {post.data.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
  <p class="muted" style="margin-bottom:0">{post.data.summary}</p>
</article>
